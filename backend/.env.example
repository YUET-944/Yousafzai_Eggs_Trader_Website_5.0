# Server Configuration
PORT=4000
NODE_ENV=production

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=yousafzai_db
# Set DB_AUTO_CREATE=false if your production database user lacks CREATE DATABASE privileges
DB_AUTO_CREATE=true

# Security & Authentication
# Generate a strong 32+ character random secret for signing JWTs
JWT_SECRET=replace-with-strong-random-jwt-secret

# SuperAdmin Automatic Bootstrap Credentials
# Configured in Coolify/production environment variables.
# When deploying, if no SuperAdmin exists, this account is created automatically.
# Password must be at least 12 characters and include letters and numbers.
ADMIN_EMAIL=admin@yousafzai.com
ADMIN_PASSWORD=replace-with-strong-production-password

# Optional CORS Allowed Origins (comma-separated if multiple)
# CORS_ORIGIN=https://yousafzaiagrifoods.com,https://www.yousafzaiagrifoods.com

# Cloud Media Storage (Cloudinary - Optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
